{
  "$schema": "https://json.schemastore.org/prettierrc",
  "arrowParens": "avoid",
  "semi": false,
  "singleQuote": true,
  "tabwidth": 2,
  "useTabs": false,
  "trailingComma": "none",
  "printWidth": 320,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "vueIndentScriptAndStyle": false,
  "singleAttributePerLine": false,
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.json5"],
      "options": {
        "singleQuote": false,
        "quoteProps": "preserve"
      }
    }
  ]
}
