root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
tab_width = 2
semi = false

[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,vue,css,scss,sass,less,styl}]
charset = utf-8
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf
max_line_length = 280

[*.py]
indent_style = space
indent_size = 4
tab_width = 4
charset = utf-8
end_of_line = crlf

[*.ipynb]
indent_style = space
indent_size = 4
tab_width = 4
charset = utf-8

[*.sql]
end_of_line = crlf
indent_size = 4
tab_width = 4

[*.pq]
indent_size = 2

[*.cs]
indent_size = 2

[*.toml]
indent_style = space
indent_size = 4
tab_width = 4
charset = utf-8
end_of_line = crlf
